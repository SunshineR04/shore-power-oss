# === 岸电码头运维系统环境变量 ===
# 复制此文件为 .env 并通过 shell/容器/CI 注入到后端进程环境（Spring Boot 不会自动读取项目根 .env）

# JWT密钥（必填，请使用强随机字符串，至少32字节；缺失或过短时后端拒绝启动）
# 生成示例: openssl rand -base64 48
JWT_SECRET=

# JWT 过期时间（毫秒），可选，默认 7200000（2小时）
JWT_EXPIRATION=7200000

# MySQL配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shorepower
DB_USER=root
DB_PASSWORD=
